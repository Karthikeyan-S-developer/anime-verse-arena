{
  "version": 3,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/client" }
    },
    {
      "src": "api/questions.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/api/questions$", "dest": "/api/questions.ts" },
    { "src": "^(?!/api/).*$", "dest": "/index.html" }
  ]
}
